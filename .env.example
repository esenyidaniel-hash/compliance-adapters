# .env.example
#
# Copy this file to .env and fill in real values before running any package
# locally. The root .gitignore already ignores .env so real secrets will not
# be committed. Placeholder values are written as ALL_CAPS_DESCRIPTION.
#
# Variables are grouped by the package that consumes them. A value used by
# more than one package is listed once under the package that owns it and
# cross-referenced elsewhere.

# ---------------------------------------------------------------------------
# Stellar network (shared across all three packages)
# ---------------------------------------------------------------------------

# Soroban RPC endpoint to connect to.
# Testnet:  https://soroban-testnet.stellar.org
# Mainnet:  https://mainnet.stellar.validationcloud.io/v1/YOUR_API_KEY
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Stellar network passphrase — must match the network STELLAR_RPC_URL points at.
# Testnet:  "Test SDF Network ; September 2015"
# Mainnet:  "Public Global Stellar Network ; September 2015"
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# ---------------------------------------------------------------------------
# sep10-auth
# ---------------------------------------------------------------------------

# Secret key for the server-side SEP-10 signing keypair (S...  56-char base32).
# Generate a fresh keypair on testnet: https://laboratory.stellar.org/#account-creator
# NEVER share or commit this value.
SEP10_SERVER_SECRET=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Corresponding public key (G...  56-char base32) derived from SEP10_SERVER_SECRET.
# Used as `serverAccountId` in verifyChallenge / createSep10Middleware.
SEP10_SERVER_PUBLIC_KEY=GXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# The home domain this server issues SEP-10 challenges for (no protocol prefix).
# Example: "example.com" or "localhost:3000" for local development.
SEP10_HOME_DOMAIN=localhost:3000

# The web-auth domain embedded in the challenge transaction (often the same as
# SEP10_HOME_DOMAIN unless auth is served from a dedicated subdomain).
SEP10_WEB_AUTH_DOMAIN=localhost:3000

# Lifetime of a SEP-10 challenge in seconds before it expires (default: 300).
SEP10_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# sanctions-oracle
# ---------------------------------------------------------------------------

# Contract ID of the deployed `denylist-gate` Soroban contract that the sync
# script will call `add_to_denylist(address)` on.
DENYLIST_GATE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Secret key for the Stellar account that will fund and sign denylist
# transactions submitted by the sync script.
# Must have sufficient XLM to cover transaction fees on the target network.
# Preferred over the --secret-key CLI flag (which is visible in shell history).
SANCTIONS_ORACLE_SECRET_KEY=SXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ---------------------------------------------------------------------------
# horizon-listener
# ---------------------------------------------------------------------------

# Contract ID of the deployed `denylist-gate` Soroban contract to listen for
# events on. Passed as one entry in the `contractIds` array to RpcEventSource.
DENYLIST_GATE_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Contract ID of the deployed `allowlist-token` Soroban contract to listen for
# events on.
ALLOWLIST_TOKEN_CONTRACT_ID=CXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# URL of the webhook endpoint that HorizonListener will POST contract events to.
# Example for local development: http://localhost:4000/webhook
WEBHOOK_URL=https://your-service.example.com/webhook

# How often (in milliseconds) to poll Soroban RPC for new contract events
# (default: 5000 ms = 5 s).
POLL_INTERVAL_MS=5000

# Maximum number of consecutive poll failures before the listener gives up and
# rejects (default: 10). Set higher if your RPC endpoint is flaky.
MAX_RETRIES=10

# The starting ledger sequence number for the very first event query (before
# any cursor is available). Should be a recent ledger within the RPC node's
# retention window — check the current ledger at
# https://horizon-testnet.stellar.org/ledgers?order=desc&limit=1
START_LEDGER=YOUR_STARTING_LEDGER_NUMBER

# ---------------------------------------------------------------------------
# Shared / example-only
# ---------------------------------------------------------------------------

# Port the example Express app listens on (sep10-auth example).
PORT=3000

# Secret key used by HttpWebhookSender to sign outbound webhook requests
# (HMAC-SHA256). Must match the verification key on the receiver side.
# Only needed if webhook signature verification is enabled.
WEBHOOK_SIGNING_SECRET=whsec_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
